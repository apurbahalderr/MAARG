# =========================================================
# MAARG ML GITIGNORE
# =========================================================

# Python virtual environment
.venv/

# Python
__pycache__/
*.pyc
.env

# -------------------------
# Raw datasets
# -------------------------
data/raw/

# -------------------------
# Intermediate datasets
# -------------------------
data/interim/

# -------------------------
# Processed datasets
# -------------------------
data/processed/

# -------------------------
# Generated feature tables
# -------------------------
data/features/

# -------------------------
# Trained models
# Small runtime artifacts required by the API are committed.
# Anything large/new should stay ignored unless explicitly allowed.
# -------------------------
models/*
*.pkl
!models/disruption_xgb.pkl
!models/eta_xgb_v1.pkl
!models/disruption_lr_baseline.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.ckpt
*.h5
*.keras
*.safetensors

# -------------------------
# Scientific / geospatial data
# -------------------------
*.tif
*.tiff
*.geotiff
*.img
*.vrt
*.nc
*.nc4
*.cdf
*.hdf
*.hdf4
*.hdf5
*.grib
*.grib2

# -------------------------
# Large archives
# -------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# -------------------------
# Large tabular datasets
# -------------------------
*.csv
*.parquet
*.feather
*.arrow

# -------------------------
# ML experiments
# -------------------------
runs/
experiments/
checkpoints/

# -------------------------
# Generated output
# -------------------------
outputs/
artifacts/
reports/generated/

# -------------------------
# Logs
# -------------------------
*.log

# -------------------------
# Allow tiny committed fixtures
# -------------------------
!data/samples/
!data/samples/**
!data/samples/*.csv
!data/samples/*.parquet
!data/samples/*.json
!data/samples/*.geojson

# -------------------------
# Large regenerable training datasets (rebuild via train_eta_model.py)
# Do NOT push these to GitHub.
# -------------------------
data/samples/model2_eta_training.csv
data/samples/disruption_training.csv
